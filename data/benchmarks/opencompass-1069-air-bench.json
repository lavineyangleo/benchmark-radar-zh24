{"record": {"artifacts": [{"id": "arxiv:2402.07729", "kind": "paper", "locator": "linked URL", "url": "https://arxiv.org/pdf/2402.07729"}, {"id": "gh:OFA-Sys/AIR-Bench", "kind": "repo", "locator": "GitHub repository URL", "url": "https://github.com/OFA-Sys/AIR-Bench"}, {"id": "hf:qyang1021/AIR-Bench-Dataset", "kind": "dataset", "locator": "Hugging Face dataset URL", "url": "https://huggingface.co/datasets/qyang1021/AIR-Bench-Dataset"}], "categories": ["知识", "Knowledge", "ACL 2024", "大语言模型", "LLM", "知识储备", "不支持", "Unsupported"], "description": {"en": "AIR-Bench is the first benchmark designed to evaluate the\nability of LALMs to understand various types of audio signals (including human speech, natural sounds, and music), and furthermore, to interact with humans in the textual format.", "zh": "AIR-Bench 是第一个旨在评估 LALMs 理解各种音频信号（包括人类语言、自然声音和音乐）能力的基准，并进一步评估其以文本形式与人类互动的能力。AIR-Bench 包括两个维度：基础基准和聊天基准。前者由19个任务组成，包含约19,000个单选题，旨在检查LALMs的基本单任务能力。后者包含2,000个开放式问答数据实例，直接评估模型对复杂音频的理解及其遵循指令的能力。"}, "documents": [{"document_type": "registry_page", "id": "opencompass_hub:https://hub.opencompass.org.cn/dataset-detail/AIR-Bench", "source": "opencompass_hub", "source_url": "https://hub.opencompass.org.cn/dataset-detail/AIR-Bench", "title": "AIR-Bench"}], "evidence_summary": {"document_count": 1, "model_count": null, "model_count_basis": null}, "key": "opencompass:1069", "languages": [], "modality": null, "name": "AIR-Bench", "openness": {"access_gate": "none", "basis": "Row 6: linked target returned 404/410/timeout and no concrete data artifact was found", "code_license": null, "code_license_note": null, "data_license": null, "data_license_note": null, "data_located": "not_found_at_this_location", "evidence": [], "link_status": "timeout", "status": "unknown"}, "possible_variant": false, "provenance": {"crawl_bundle": "OpenCompassHub_Round2_Public_Evidence_2026-08-18", "crawled_at": "2026-08-18T00:00:00+00:00", "inputs": {"catalog_snapshot": {"crawled_at": "2026-08-17T18:57:37.200294+00: