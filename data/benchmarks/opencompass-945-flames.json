{"record": {"artifacts": [{"id": "arxiv:2311.06899", "kind": "paper", "locator": "linked URL", "url": "https://arxiv.org/abs/2311.06899"}, {"id": "gh:AIFlames/Flames", "kind": "repo", "locator": "GitHub repository URL", "url": "https://github.com/AIFlames/Flames"}], "categories": ["安全", "Safety", "NAACL 2024", "大语言模型", "LLM", "安全对齐", "Safety Alignment", "合作共建", "Co-Built", "不支持", "Unsupported"], "description": {"en": "Flames is a highly adversarial benchmark in Chinese for LLM's value alignment evaluation developed by Shanghai AI Lab and Fudan NLP Group. Flames meticulously designs a dataset of 2,251 highly adversarial, manually crafted prompts, each tailored to probe a specific value dimension (i.e., Fairness, Safety, Morality, Legality, Data protection). Currently,  Flames releases 1,000 prompts for public use (Flames_1k_Chinese).", "zh": "Flames 是上海人工智能实验室和复旦大学 NLP团队开发的 LLM 价值对齐方向的中文高度对抗性基准。Flames 精心设计了一个由 2,251 个高度对抗性、人工创建的提示词成的评测集，每个提示词都经过精心设计，以探究特定的价值维度（即公平、安全、道德、合法、数据保护）。目前，Flames 发布了 1,000 个提示词供公众使用（Flames_1k_Chinese）。"}, "documents": [{"document_type": "registry_page", "id": "opencompass_hub:https://hub.opencompass.org.cn/dataset-detail/Flames", "source": "opencompass_hub", "source_url": "https://hub.opencompass.org.cn/dataset-detail/Flames", "title": "Flames"}], "evidence_summary": {"document_count": 1, "model_count": null, "model_count_basis": null}, "key": "opencompass:945", "languages": ["Chinese"], "modality": null, "name": "Flames", "openness": {"access_gate": "none", "basis": "Row 3: data_located=found with no data_license found", "code_license": "Apache-2.0", "code_license_note": null, "data_license": null, "data_license_note": null, "data_located": "found", "evidence": [{"evidence_url": "https://github.com/AIFlames/Flames/blob/main/Flames_1k_Chinese.jsonl", "locator": "HTTP HEAD or range GET response headers"}], "link_status": "redirect", "status": "restricted"}, "possible_variant": false, "provenance": {"crawl_bundle": "OpenCompassHub_Round2_Publi