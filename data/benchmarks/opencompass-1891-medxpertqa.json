{"record": {"artifacts": [{"id": "arxiv:2501.18362", "kind": "paper", "locator": "linked URL", "url": "https://arxiv.org/abs/2501.18362"}, {"id": "gh:TsinghuaC3I/MedXpertQA", "kind": "repo", "locator": "GitHub repository URL", "url": "https://github.com/TsinghuaC3I/MedXpertQA"}, {"id": "hf:TsinghuaC3I/MedXpertQA", "kind": "dataset", "locator": "Hugging Face dataset URL", "url": "https://huggingface.co/datasets/TsinghuaC3I/MedXpertQA"}], "categories": ["学科", "Examination", "推理", "Reasoning", "知识", "Knowledge", "Medical", "ICML 2025", "科学智能", "AI for Science", "知识储备", "逻辑推理", "科学推理", "Scientific Reasoning", "不支持", "Unsupported"], "description": {"en": "We introduce MedXpertQA, a highly challenging and comprehensive medical benchmark to evaluate expert-level medical knowledge and advanced reasoning. \nIt has been accepted by ICML 2025 and selected by Google DeepMind as the benchmark for MedGemma.", "zh": "MedXpertQA是由清华大学和上海人工智能实验室构建的全面且具有高度挑战性的医学基准，用于评估专家级的医学知识和高级推理能力。论文已被ICML 2025接收，并被Google DeepMind使用作为MedGemma的评估基准。MedXpertQA 共包含 4,460 道题目，涵盖 17 个医学专科和 11 个身体系统。该基准包含两个子集：用于文本医学能力评估的 Text 子集，以及用于多模态医学能力评估的 MM 子集。MM 子集首次引入了带有多样化图像和丰富临床信息（如病历和检查结果）的专家级考试题，区别于传统多模态医学基准中基于图像描述生成的简单问答对。"}, "documents": [{"document_type": "registry_page", "id": "opencompass_hub:https://hub.opencompass.org.cn/dataset-detail/MedXpertQA", "source": "opencompass_hub", "source_url": "https://hub.opencompass.org.cn/dataset-detail/MedXpertQA", "title": "MedXpertQA"}], "evidence_summary": {"document_count": 1, "model_count": null, "model_count_basis": null}, "key": "opencompass:1891", "languages": [], "modality": null, "name": "MedXpertQA", "openness": {"access_gate": "none", "basis": "Row 1: code_public=yes; data_located=found; data_license=permissive_or_sharealike", "code_license": "MIT", "code_license_note": null, "data_license": "MIT", "data_license_note": null, "data_located": "found", "evidence": [{"evidence_url": "https://huggingface.co/api/datasets/TsinghuaC3I/MedXpertQA/tree/main?recursive=true&expand=false", "locator": "file listing: MM/dev.jsonl"}, {"evidence_url": "https://huggingface.co/api/datasets/TsinghuaC3I/MedXpertQA", "locator": "cardData.license", "value": "mit"}], "link_status": "timeout", "status": "open"}, "possible_variant": false, "provenance": {"crawl_bundle": "OpenCompassHub_Round2_Public_Evidence_2026-08-18", "crawled_at": "2026-08-18T00:00:00+00:00", "inputs": {"catalog_snapshot": {"crawled_at": "2026-08-17T18:57:37.200294+00:00", "file": "data/leaderboard_snapshots/opencompass_hub_catalog_2026-08-17.csv", "id": "opencompass_hub_2026-08-17", "source_url": "https://hub.opencompass.org.cn/home"}, "round2_evidence": {"crawled_at": "2026-08-18T00:00:00+00:00", "file": "data\\leaderboard_snapshots\\opencompass_round2\\opencompass_round2.jsonl", "id": "OpenCompassHub_Round2_Public_Evidence_2026-08-18"}}, "source_url": "https://hub.opencompass.org.cn/dataset-detail/MedXpertQA"}, "publisher": {"locator": "detail.basicInfo.publishOrg", "name": "清华大学，上海人工智能实验室", "role": "hub_publisher"}, "released": "2025-02-09", "schema_version": 1, "sizes": [{"evidence_url": "https://datasets-server.huggingface.co/size?dataset=TsinghuaC3I%2FMedXpertQA", "measures": "eval_set", "origin": "dataset_viewer", "split": "dev", "unit": "items", "value": 5}, {"evidence_url": "https://datasets-server.huggingface.co/size?dataset=TsinghuaC3I%2FMedXpertQA", "measures": "eval_set", "origin": "dataset_viewer", "split": "test", "unit": "items", "value": 2000}, {"evidence_url": "https://datasets-server.huggingface.co/size?dataset=TsinghuaC3I%2FMedXpertQA", "measures": "eval_set", "origin": "dataset_viewer", "split": "dev", "unit": "items", "value": 5}, {"evidence_url": "https://datasets-server.huggingface.co/size?dataset=TsinghuaC3I%2FMedXpertQA", "measures": "eval_set", "origin": "dataset_viewer", "split": "test", "unit": "items", "value": 2450}, {"evidence_quote": "MedXpertQA is a benchmark designed to evaluate expert-level medical knowledge and advanced reasoning. It comprises 4,460 questions covering 17 medical specialties and 11 body systems. The dataset is d", "evidence_url": "https://hub.opencompass.org.cn/dataset-detail/MedXpertQA", "measures": "eval_set", "origin": "readme", "split": null, "unit": "questions", "value": 4460}, {"evidence_quote": "MedXpertQA** includes 4,460 questions spanning diverse medical specialties, tasks, body systems, and image types. It includes two subsets, **MedXpertQA Text** for text medical evaluation and **MedXper", "evidence_url": "https://hub.opencompass.org.cn/dataset-detail/MedXpertQA", "measures": "eval_set", "origin": "readme", "split": null, "unit": "questions", "value": 4460}, {"evidence_quote": "Within each subset (**Text** or **MM**), `test.jsonl` contains the test set (2,450 questions for **Text** and 2,000 for **MM**) and `dev.jsonl` contains the development set (5 for each subset).", "evidence_url": "https://hub.opencompass.org.cn/dataset-detail/MedXpertQA", "measures": "eval_set", "origin": "readme", "split": null, "unit": "questions", "value": 2450}], "slug": "opencompass-1891-medxpertqa", "source": "opencompass_hub", "source_benchmark_id": "1891", "version_reported": null}, "schema_version": 1, "scores_by_source": {}, "siblings": []}
