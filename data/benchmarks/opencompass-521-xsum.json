{"record": {"artifacts": [{"id": "arxiv:1808.08745", "kind": "paper", "locator": "linked URL", "url": "https://arxiv.org/abs/1808.08745"}, {"id": "gh:EdinburghNLP/XSum", "kind": "repo", "locator": "GitHub repository URL", "url": "https://github.com/EdinburghNLP/XSum"}], "categories": ["理解", "Understanding", "大语言模型", "LLM", "语言理解", "Comprehension", "开源收录", "Open-Source", "不支持", "Unsupported"], "description": {"en": "XSum is a single-document summarization task which does not favor extractive strategies and calls for an abstractive modeling approach. The idea is to create a short, one-sentence news summary answering the question “What is the article about?”. The dataset collects real-world, large scale data by harvesting online articles from the British Broadcasting Corporation (BBC).", "zh": "XSum是一个单文档摘要任务，不支持抽取式策略，需要采用抽象建模方法。其思想是创建一个简短的一句话新闻摘要，回答“这篇文章是关于什么的？”的问题。该数据集通过从英国广播公司（BBC）收集在线文章，得到了大量的现实数据。"}, "documents": [{"document_type": "registry_page", "id": "opencompass_hub:https://hub.opencompass.org.cn/dataset-detail/XSum", "source": "opencompass_hub", "source_url": "https://hub.opencompass.org.cn/dataset-detail/XSum", "title": "XSum"}], "evidence_summary": {"document_count": 1, "model_count": null, "model_count_basis": null}, "key": "opencompass:521", "languages": [], "modality": null, "name": "XSum", "openness": {"access_gate": "none", "basis": "Row 5: data_located=not_found_at_this_location", "code_license": "MIT", "code_license_note": null, "data_license": null, "data_license_note": null, "data_located": "not_found_at_this_location", "evidence": [], "link_status": "ok", "status": "unknown"}, "possible_variant": false, "provenance": {"crawl_bundle": "OpenCompassHub_Round2_Public_Evidence_2026-08-18", "crawled_at": "2026-08-18T00:00:00+00:00", "inputs": {"catalog_snapshot": {"crawled_at": "2026-08-17T18:57:37.200294+00:00", "file": "data/leaderboard_snapshots/opencompass_hub_catalog_2026-08-17.csv", "id": "opencompass_hub_2026-08-17", "source_url": "https://hub.o