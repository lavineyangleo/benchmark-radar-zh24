{"record": {"aliases": [], "artifacts": [], "categories": ["long_context", "reasoning", "code"], "description": {"en": "RepoQA is a benchmark for evaluating long-context code understanding capabilities of Large Language Models through the Searching Needle Function (SNF) task, where LLMs must locate specific functions in code repositories using natural language descriptions. The benchmark contains 500 code search tasks spanning 50 repositories across 5 modern programming languages (Python, Java, TypeScript, C++, and Rust), tested on 26 general and code-specific LLMs to assess their ability to comprehend and navigate code repositories."}, "documents": [{"document_type": "registry_page", "id": "llm_stats:https://api.zeroeval.com/leaderboard/benchmarks/repoqa?top_n=500", "source": "llm_stats", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/repoqa?top_n=500", "title": "RepoQA"}], "evidence_summary": {"document_count": 1, "model_count": 2, "model_count_basis": "source_model_id"}, "key": "llm-stats:repoqa", "modality": "text", "name": "RepoQA", "openness": {"code_license": null, "data_license": null, "evidence": [], "status": "unknown"}, "provenance": {"crawl_bundle": "llm_stats_2026-08-17", "crawled_at": "2026-08-17T18:49:35.489925+00:00", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/repoqa?top_n=500"}, "publisher": null, "released": "2024-06-10", "released_reference": {"basis": "paper_first_version", "note": "First version of the introducing paper: RepoQA: Evaluating Long Context Code Understanding. The source-record description identifies this benchmark or its original partition; no dates or scores are joined by name at runtime.", "source_key": "llm-stats:repoqa", "source_url": "https://arxiv.org/abs/2406.06025"}, "schema_version": 1, "sizes": [], "slug": "llm-stats-repoqa", "source": "llm_stats", "source_benchmark_id": "repoqa"}, "schema_version": 1, "scores_by_source": {"llm_stats": {"rows": [{"comparable_group": null, "crawled_at": "