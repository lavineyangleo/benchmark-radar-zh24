{"record": {"artifacts": [{"id": "arxiv:2506.09902", "kind": "paper", "locator": "linked URL", "url": "https://arxiv.org/abs/2506.09902"}, {"id": "gh:amazon-science/PersonaLens", "kind": "repo", "locator": "GitHub repository URL", "url": "https://github.com/amazon-science/PersonaLens"}], "categories": ["语言", "Language", "智能体", "Agent", "AI Assistant", "personalization", "任务执行", "Task Execution", "语言理解", "Comprehension", "不支持", "Unsupported"], "description": {"en": "PersonaLens  a large-scale benchmark specifically designed to evaluate personalization in task-oriented dialogues. The benchmark features 1,500 in-depth user profiles, each integrating real demographic data, detailed cross-domain preferences, and rich interaction histories.", "zh": "PersonaLens是一个专为任务导向型对话设计的、大规模的个性化能力评测基准。它包含1,500个深度用户画像，每个画像都集成了真实的人口统计信息、详尽的个人偏好及历史互动记录。这些画像与覆盖20个领域的111项真实世界任务相结合，并辅以动态的“情景上下文”来模拟现实世界的复杂性。为了实现自动化、可扩展的评估，该基准引入了两个LLM驱动的智能体：一个“用户智能体”负责模拟真人与AI进行对话，另一个“评判智能体”则对个性化水平、任务成功率和对话质量进行系统性打分。PersonaLens旨在为研究社区提供一个强大可靠的工具，共同推动下一代更懂你、更智能的AI助手的研发。"}, "documents": [{"document_type": "registry_page", "id": "opencompass_hub:https://hub.opencompass.org.cn/dataset-detail/PersonaLens", "source": "opencompass_hub", "source_url": "https://hub.opencompass.org.cn/dataset-detail/PersonaLens", "title": "PersonaLens"}], "evidence_summary": {"document_count": 1, "model_count": null, "model_count_basis": null}, "key": "opencompass:1959", "languages": [], "modality": null, "name": "PersonaLens", "openness": {"access_gate": "none", "basis": "Row 5: data_located=not_found_at_this_location", "code_license": null, "code_license_note": "file_present_unparsed", "data_license": null, "data_license_note": null, "data_located": "not_found_at_this_location", "evidence": [], "link_status": "ok", "status": "unknown"}, "possible_variant": false, "provenance": {"crawl_bundle": "OpenCompassHub_Round2_Public_Evidence_2026-08-18", "crawled_at": "2026-08-18T00:00:00+00:00", "inputs": {"catalog_snapshot": {"crawled_at": "