{"record": {"artifacts": [{"id": "arxiv:2512.16969", "kind": "paper", "locator": "linked URL", "url": "https://arxiv.org/pdf/2512.16969"}, {"id": "gh:InternScience/SGI-Bench", "kind": "repo", "locator": "GitHub repository URL", "url": "https://github.com/InternScience/SGI-Bench"}], "categories": ["多模态", "Multimodal", "科学", "Science", "代码", "Code", "deep research", "reasoning", "lab protocol", "科学智能", "AI for Science", "科学推理", "Scientific Reasoning", "代码工程", "逻辑推理", "跨模态推理", "Cross-modal Reasoning", "不支持", "Unsupported"], "description": {"en": "SGI-Bench operationalizes this definition via four scientist-aligned task families: deep research, idea generation, dry/wet experiments, and multimodal experimental reasoning. The benchmark spans 10 disciplines and more than 1,000 expert-curated samples inspired by Science's 125 Big Questions.", "zh": "科学通用智能（SGI）被定义为一种人工智能系统，其能够以接近人类科学家的通用性与熟练程度，自主地贯穿并迭代完整的科学研究流程，包括审思、构思、行动与感知四个阶段。SGI-Bench 通过四类与科学家工作流程对齐的任务对上述定义进行操作化刻画，具体包括：深度研究、思想与假设生成、干/湿实验、以及多模态实验推理。该评测基准覆盖10 个科学学科领域，包含1,000 余个由领域专家精心策划的样本，其设计灵感来源于 Science 杂志提出的 125 个重大科学问题（125 Big Questions）。"}, "documents": [{"document_type": "registry_page", "id": "opencompass_hub:https://hub.opencompass.org.cn/dataset-detail/SGI-Bench", "source": "opencompass_hub", "source_url": "https://hub.opencompass.org.cn/dataset-detail/SGI-Bench", "title": "SGI-Bench"}], "evidence_summary": {"document_count": 1, "model_count": null, "model_count_basis": null}, "key": "opencompass:2325", "languages": [], "modality": "multimodal", "name": "SGI-Bench", "openness": {"access_gate": "none", "basis": "Row 5: data_located=not_found_at_this_location", "code_license": "MIT", "code_license_note": null, "data_license": null, "data_license_note": null, "data_located": "not_found_at_this_location", "evidence": [], "link_status": "ok", "status": "unknown"}, "possible_variant": false, "provenance": {"crawl_bundle": "OpenCompassHub_Round2_Public_Evidence_2026-08-18", "crawled_at": "2026-08-18T00:00:00+00:00", "i