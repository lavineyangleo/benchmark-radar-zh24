{"record": {"artifacts": [{"id": "arxiv:2506.08933", "kind": "paper", "locator": "linked URL", "url": "https://arxiv.org/abs/2506.08933"}, {"id": "gh:antgroup/OmniBench", "kind": "repo", "locator": "GitHub repository URL", "url": "https://github.com/antgroup/OmniBench"}], "categories": ["智能体", "Agent", "任务执行", "Task Execution", "不支持", "Unsupported"], "description": {"en": "OmniBench is a multi-dimensional benchmark for virtual agents, designed to systematically evaluate ten core capabilities such as planning, decision-making, and instruction comprehension through automatically generated task graphs with controllable complexity.", "zh": "OmniBench 是一个面向虚拟智能体的多维度评测基准，旨在通过自动化流程生成具有可控复杂度的任务图，系统评估智能体在计划、决策、指令理解等十个核心能力上的表现。该基准包含 36,000 个图结构任务，覆盖 20 个真实场景，并引入 OmniEval 框架，实现子任务级别的细粒度评估，显著提升了评测的效率和可扩展性。"}, "documents": [{"document_type": "registry_page", "id": "opencompass_hub:https://hub.opencompass.org.cn/dataset-detail/OmniBench", "source": "opencompass_hub", "source_url": "https://hub.opencompass.org.cn/dataset-detail/OmniBench", "title": "OmniBench"}], "evidence_summary": {"document_count": 1, "model_count": null, "model_count_basis": null}, "key": "opencompass:1981", "languages": [], "modality": null, "name": "OmniBench", "openness": {"access_gate": "none", "basis": "Row 5: data_located=not_found_at_this_location", "code_license": null, "code_license_note": null, "data_license": null, "data_license_note": null, "data_located": "not_found_at_this_location", "evidence": [], "link_status": "ok", "status": "unknown"}, "possible_variant": false, "provenance": {"crawl_bundle": "OpenCompassHub_Round2_Public_Evidence_2026-08-18", "crawled_at": "2026-08-18T00:00:00+00:00", "inputs": {"catalog_snapshot": {"crawled_at": "2026-08-17T18:57:37.200294+00:00", "file": "data/leaderboard_snapshots/opencompass_hub_catalog_2026-08-17.csv", "id": "opencompass_hub_2026-08-17", "source_url": "https://hub.opencompass.org.cn/home"}, "round2_evidence": {"crawled_at": "2026-08-18T00:00:00+00:00"