{"record": {"artifacts": [{"id": "arxiv:2505.11034", "kind": "paper", "locator": "linked URL", "url": "https://arxiv.org/pdf/2505.11034"}, {"id": "gh:Digital-Dermatology/CleanPatrick", "kind": "repo", "locator": "GitHub repository URL", "url": "https://github.com/Digital-Dermatology/CleanPatrick"}, {"id": "hf:Digital-Dermatology/CleanPatrick", "kind": "dataset", "locator": "Hugging Face dataset URL", "url": "https://huggingface.co/datasets/Digital-Dermatology/CleanPatrick"}], "categories": ["理解", "Understanding", "安全", "Safety", "大语言模型", "LLM", "语言理解", "Comprehension", "安全对齐", "Safety Alignment", "不支持", "Unsupported"], "description": {"en": "CleanPatrick is a large-scale, real-world image data-cleaning benchmark with 496,377 binary annotations from 933 medical crowd workers for ranking off-topic, near-duplicate, and label-error issues.", "zh": "CleanPatrick是首个大规模图像数据清洗基准，基于公开的Fitzpatrick17k皮肤科数据集构建。该基准包含超过50万条来自933名医学众包工人的二元注释，涵盖三种数据质量问题：离题样本、近似重复样本和标签错误。通过医学专家验证，CleanPatrick提供了高质量的基准数据，用于评估图像数据清洗策略。基准测试结果表明，现有的数据清洗方法在近似重复检测中表现出色，但在标签错误检测方面仍面临挑战。CleanPatrick为数据清洗方法提供了标准化的评估框架，推动了更可靠的数据中心人工智能的发展。"}, "documents": [{"document_type": "registry_page", "id": "opencompass_hub:https://hub.opencompass.org.cn/dataset-detail/CleanPatrick", "source": "opencompass_hub", "source_url": "https://hub.opencompass.org.cn/dataset-detail/CleanPatrick", "title": "CleanPatrick"}], "evidence_summary": {"document_count": 1, "model_count": null, "model_count_basis": null}, "key": "opencompass:1849", "languages": [], "modality": null, "name": "CleanPatrick", "openness": {"access_gate": "none", "basis": "Row 2: code_public=yes; data_located=found; data_license=non-commercial/no-derivs/custom_or_other", "code_license": null, "code_license_note": null, "data_license": "CC-BY-NC-4.0", "data_license_note": null, "data_located": "found", "evidence": [{"evidence_url": "https://huggingface.co/api/datasets/Digital-Dermatology/CleanPatrick/tree/main?recursive=true&expand=false", "locator": "file listin