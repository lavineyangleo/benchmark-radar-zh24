{"record": {"aliases": [], "artifacts": [], "categories": ["reasoning", "general"], "description": {"en": "A dataset of 7,787 genuine grade-school level, multiple-choice science questions assembled to encourage research in advanced question-answering. The dataset is partitioned into a Challenge Set and Easy Set, where the Challenge Set contains only questions answered incorrectly by both retrieval-based and word co-occurrence algorithms. Covers multiple scientific domains including biology, physics, earth science, and chemistry, requiring scientific reasoning, causal understanding, and conceptual knowledge beyond simple fact retrieval. Includes a supporting corpus of over 14 million science sentences."}, "documents": [{"document_type": "registry_page", "id": "llm_stats:https://api.zeroeval.com/leaderboard/benchmarks/ai2-reasoning-challenge-%28arc%29?top_n=500", "source": "llm_stats", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/ai2-reasoning-challenge-%28arc%29?top_n=500", "title": "AI2 Reasoning Challenge (ARC)"}], "evidence_summary": {"document_count": 1, "model_count": 1, "model_count_basis": "source_model_id"}, "key": "llm-stats:ai2-reasoning-challenge-(arc)", "modality": "text", "name": "AI2 Reasoning Challenge (ARC)", "openness": {"code_license": null, "data_license": null, "evidence": [], "status": "unknown"}, "provenance": {"crawl_bundle": "llm_stats_2026-08-17", "crawled_at": "2026-08-17T18:49:35.489925+00:00", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/ai2-reasoning-challenge-%28arc%29?top_n=500"}, "publisher": null, "released": "2018-03-14", "released_reference": {"basis": "paper_first_version", "note": "First version of the introducing paper: Think you have Solved Question Answering? Try ARC, the AI2 Reasoning Challenge. The source-record description identifies this benchmark or its original partition; no dates or scores are joined by name at runtime.", "source_key": "llm-stats:ai2-reasoning-challenge-(arc)", "source