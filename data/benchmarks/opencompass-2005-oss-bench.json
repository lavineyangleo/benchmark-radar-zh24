{"record": {"artifacts": [{"id": "arxiv:2505.12331", "kind": "paper", "locator": "linked URL", "url": "https://arxiv.org/abs/2505.12331"}, {"id": "gh:oss-bench/oss-bench", "kind": "repo", "locator": "GitHub repository URL", "url": "https://github.com/oss-bench/oss-bench"}], "categories": ["代码", "Code", "Memory Safety", "Open-Source Software", "Living Benchmark", "大语言模型", "LLM", "代码工程", "不支持", "Unsupported"], "description": {"en": "OSS-Bench replaces functions with LLM-generated code and evaluates them using three natural metrics: compilability, functional correctness, and memory safety, leveraging robust signals like compilation failures, test-suite violations, and sanitizer alerts as ground truth.", "zh": "OSS-Bench，这是一个基准生成器，它可以从真实的开源软件中自动构建大规模的实时评估任务。OSS-Bench 将函数替换为 LLM 生成的代码，并使用三个自然指标（可编译性、功能正确性和内存安全性）对其进行评估，并利用编译失败、测试套件违规和Sanitizer警报等稳健信号作为基准事实。"}, "documents": [{"document_type": "registry_page", "id": "opencompass_hub:https://hub.opencompass.org.cn/dataset-detail/OSS-Bench", "source": "opencompass_hub", "source_url": "https://hub.opencompass.org.cn/dataset-detail/OSS-Bench", "title": "OSS-Bench"}], "evidence_summary": {"document_count": 1, "model_count": null, "model_count_basis": null}, "key": "opencompass:2005", "languages": [], "modality": null, "name": "OSS-Bench", "openness": {"access_gate": "none", "basis": "Row 5: data_located=not_found_at_this_location", "code_license": null, "code_license_note": null, "data_license": null, "data_license_note": null, "data_located": "not_found_at_this_location", "evidence": [], "link_status": "ok", "status": "unknown"}, "possible_variant": false, "provenance": {"crawl_bundle": "OpenCompassHub_Round2_Public_Evidence_2026-08-18", "crawled_at": "2026-08-18T00:00:00+00:00", "inputs": {"catalog_snapshot": {"crawled_at": "2026-08-17T18:57:37.200294+00:00", "file": "data/leaderboard_snapshots/opencompass_hub_catalog_2026-08-17.csv", "id": "opencompass_hub_2026-08-17", "source_url": "https://hub.opencompass.org.cn/home"}, "ro