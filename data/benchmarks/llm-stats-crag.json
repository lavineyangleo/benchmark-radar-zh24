{"record": {"aliases": [], "artifacts": [], "categories": ["reasoning", "search", "finance", "economics"], "description": {"en": "CRAG (Comprehensive RAG Benchmark) is a factual question answering benchmark consisting of 4,409 question-answer pairs across 5 domains (finance, sports, music, movie, open domain) and 8 question categories. The benchmark includes mock APIs to simulate web and Knowledge Graph search, designed to represent the diverse and dynamic nature of real-world QA tasks with temporal dynamism ranging from years to seconds. It evaluates retrieval-augmented generation systems for trustworthy question answering."}, "documents": [{"document_type": "registry_page", "id": "llm_stats:https://api.zeroeval.com/leaderboard/benchmarks/crag?top_n=500", "source": "llm_stats", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/crag?top_n=500", "title": "CRAG"}], "evidence_summary": {"document_count": 1, "model_count": 3, "model_count_basis": "source_model_id"}, "key": "llm-stats:crag", "modality": "text", "name": "CRAG", "openness": {"code_license": null, "data_license": null, "evidence": [], "status": "unknown"}, "provenance": {"crawl_bundle": "llm_stats_2026-08-17", "crawled_at": "2026-08-17T18:49:35.489925+00:00", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/crag?top_n=500"}, "publisher": null, "released": "2024-06-07", "released_reference": {"basis": "paper_first_version", "note": "First version of the introducing paper: CRAG -- Comprehensive RAG Benchmark. The source-record description identifies this benchmark or its original partition; no dates or scores are joined by name at runtime.", "source_key": "llm-stats:crag", "source_url": "https://arxiv.org/abs/2406.04744"}, "schema_version": 1, "sizes": [], "slug": "llm-stats-crag", "source": "llm_stats", "source_benchmark_id": "crag"}, "schema_version": 1, "scores_by_source": {"llm_stats": {"rows": [{"comparable_group": null, "crawled_at": "2026-08-17T18:49:35.489925+00:00", "date_p