{"record": {"aliases": [], "artifacts": [], "categories": ["multimodal", "reasoning", "vision"], "description": {"en": "TempCompass is a comprehensive benchmark for evaluating temporal perception capabilities of Video Large Language Models (Video LLMs). It constructs conflicting videos that share identical static content but differ in specific temporal aspects to prevent models from exploiting single-frame bias. The benchmark evaluates multiple temporal aspects including action, motion, speed, temporal order, and attribute changes across diverse task formats including multi-choice QA, yes/no QA, caption matching, and caption generation."}, "documents": [{"document_type": "registry_page", "id": "llm_stats:https://api.zeroeval.com/leaderboard/benchmarks/tempcompass?top_n=500", "source": "llm_stats", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/tempcompass?top_n=500", "title": "TempCompass"}], "evidence_summary": {"document_count": 1, "model_count": 2, "model_count_basis": "source_model_id"}, "key": "llm-stats:tempcompass", "modality": "multimodal", "name": "TempCompass", "openness": {"code_license": null, "data_license": null, "evidence": [], "status": "unknown"}, "provenance": {"crawl_bundle": "llm_stats_2026-08-17", "crawled_at": "2026-08-17T18:49:35.489925+00:00", "source_url": "https://api.zeroeval.com/leaderboard/benchmarks/tempcompass?top_n=500"}, "publisher": null, "released": "2024-03-01", "released_reference": {"basis": "paper_first_version", "note": "First version of the introducing paper: TempCompass: Do Video LLMs Really Understand Videos?. The source-record description identifies this benchmark or its original partition; no dates or scores are joined by name at runtime.", "source_key": "llm-stats:tempcompass", "source_url": "https://arxiv.org/abs/2403.00476"}, "schema_version": 1, "sizes": [], "slug": "llm-stats-tempcompass", "source": "llm_stats", "source_benchmark_id": "tempcompass"}, "schema_version": 1, "scores_by_source": {"llm_stat