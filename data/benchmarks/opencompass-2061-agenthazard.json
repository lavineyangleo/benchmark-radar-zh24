{"record": {"artifacts": [{"id": "arxiv:2507.04227", "kind": "paper", "locator": "linked URL", "url": "https://arxiv.org/abs/2507.04227"}, {"id": "gh:Zsbyqx20/AgentHazard", "kind": "repo", "locator": "GitHub repository URL", "url": "https://github.com/Zsbyqx20/AgentHazard"}], "categories": ["多模态", "Multimodal", "安全", "Safety", "智能体", "Agent", "任务执行", "Task Execution", "安全对齐", "Safety Alignment", "跨模态推理", "Cross-modal Reasoning", "不支持", "Unsupported"], "description": {"en": "移动端 GUI Agent 通过与设备环境的交互来完成任务，在完成任务的过程中会遇到一些未知或不可信的信息来源，这些信息可能含有攻击性的内容，致使 Agent 无法正常完成任务，甚至对用户的隐私和财产带来危害。本评测集兼具动态执行环境和静态评测数据集，旨在为移动端 GUI Agent 提供一个仿真度高的模拟环境，以评估其在真实场景下执行的行为和安全性。", "zh": "移动端 GUI Agent 通过与设备环境的交互来完成任务，在完成任务的过程中会遇到一些未知或不可信的信息来源，这些信息可能含有攻击性的内容，致使 Agent 无法正常完成任务，甚至对用户的隐私和财产带来危害。本评测集兼具动态执行环境和静态评测数据集，旨在为移动端 GUI Agent 提供一个仿真度高的模拟环境，以评估其在真实场景下执行的行为和安全性。"}, "documents": [{"document_type": "registry_page", "id": "opencompass_hub:https://hub.opencompass.org.cn/dataset-detail/AgentHazard", "source": "opencompass_hub", "source_url": "https://hub.opencompass.org.cn/dataset-detail/AgentHazard", "title": "AgentHazard"}], "evidence_summary": {"document_count": 1, "model_count": null, "model_count_basis": null}, "key": "opencompass:2061", "languages": [], "modality": "multimodal", "name": "AgentHazard", "openness": {"access_gate": "none", "basis": "Row 5: data_located=not_found_at_this_location", "code_license": null, "code_license_note": null, "data_license": null, "data_license_note": null, "data_located": "not_found_at_this_location", "evidence": [], "link_status": "ok", "status": "unknown"}, "possible_variant": false, "provenance": {"crawl_bundle": "OpenCompassHub_Round2_Public_Evidence_2026-08-18", "crawled_at": "2026-08-18T00:00:00+00:00", "inputs": {"catalog_snapshot": {"crawled_at": "2026-08-17T18:57:37.200294+00:00", "file": "data/leaderboard_snapshots/opencompass_hub_catalog_2026-08-17.csv", "id": "opencompass_hub_2026-08-17", "source_url": "https://hub.opencompass.org.cn/home"}, "round2