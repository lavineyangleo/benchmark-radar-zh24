{"record": {"artifacts": [{"id": "arxiv:2506.10857", "kind": "paper", "locator": "linked URL", "url": "https://arxiv.org/abs/2506.10857"}, {"id": "gh:OpenGVLab/VRBench", "kind": "repo", "locator": "GitHub repository URL", "url": "https://github.com/OpenGVLab/VRBench"}, {"id": "hf:OpenGVLab/VRBench", "kind": "dataset", "locator": "Hugging Face dataset URL", "url": "https://huggingface.co/datasets/OpenGVLab/VRBench"}], "categories": ["多模态", "Multimodal", "推理", "Reasoning", "视频理解", "Video-Understanding", "多步推理", "视频推理", "多语种", "多模态模型", "VLM", "逻辑推理", "Video Understanding", "不支持", "Unsupported"], "description": {"en": "VRBench is the first evaluation benchmark specifically designed to assess multi-step reasoning capabilities over long videos. The benchmark comprises 1,010 long videos with an average duration of 1.6 hours, covering 8 languages and 7 video types. It includes annotations for 9,468 reasoning steps.", "zh": "VRBench是首个专门针对长视频多步推理能力设计的评测基准VRBench。该基准包含 1010 个平均时长1.6小时的长视频，覆盖 8 种语言和 7 种视频类型，标注了 9468 个多步推理问答对和超过 3 万个详细推理步骤。本评测集能够同时对模型的推理过程和推理结果进行评分，是首个同时具备多步推理链标注和评测能力的视频评测集。"}, "documents": [{"document_type": "registry_page", "id": "opencompass_hub:https://hub.opencompass.org.cn/dataset-detail/VRBench", "source": "opencompass_hub", "source_url": "https://hub.opencompass.org.cn/dataset-detail/VRBench", "title": "VRBench"}], "evidence_summary": {"document_count": 1, "model_count": null, "model_count_basis": null}, "key": "opencompass:2383", "languages": [], "modality": "multimodal", "name": "VRBench", "openness": {"access_gate": "none", "basis": "Row 1: code_public=yes; data_located=found; data_license=permissive_or_sharealike", "code_license": "Apache-2.0", "code_license_note": null, "data_license": "Apache-2.0", "data_license_note": null, "data_located": "found", "evidence": [{"evidence_url": "https://huggingface.co/api/datasets/OpenGVLab/VRBench/tree/main?recursive=true&expand=false", "locator": "file listing: VRBench_eval.jsonl"}, {"evidence_url": "https://hu