{"record": {"artifacts": [{"id": "arxiv:2506.05523", "kind": "paper", "locator": "linked URL", "url": "https://arxiv.org/abs/2506.05523"}, {"id": "gh:morse-benchmark/morse-500", "kind": "repo", "locator": "GitHub repository URL", "url": "https://github.com/morse-benchmark/morse-500"}, {"id": "hf:video-reasoning/morse-500", "kind": "dataset", "locator": "Hugging Face dataset URL", "url": "https://huggingface.co/datasets/video-reasoning/morse-500"}, {"id": "hf:video-reasoning/morse-500-view", "kind": "dataset", "locator": "Hugging Face dataset URL", "url": "https://huggingface.co/datasets/video-reasoning/morse-500-view"}], "categories": ["强推理", "Strong Reasoning", "多模态", "Multimodal", "推理", "Reasoning", "多模态模型", "VLM", "逻辑推理", "视频理解", "Video Understanding", "不支持", "Unsupported"], "description": {"en": "MORSE-500 introduces 500 programmatically generated videos testing 6 reasoning types: abstract, physical, planning, spatial, temporal, mathematical. Its controllable generation (via Manim, Matplotlib, generative models etc.) enables scalable difficulty, designed to evolve as SOTA models improve.", "zh": "当前多模态推理基准存在三大不足：依赖静态图像、偏重数学解题、易饱和。为此，我们提出MORSE-500视频基准：包含500个脚本化视频片段，涵盖抽象、物理、规划、空间、时间、数学六类推理问题。其核心在于程序化生成（使用Manim、Matplotlib等），可精确控制视觉复杂度、干扰物密度和时序动态，从而系统化提升难度。与易过时的静态基准不同，MORSE-500具备可持续演进能力，其可控生成流程能无限创建新挑战实例。在顶尖模型（Gemini 2.5 Pro、OpenAI o3等）上的测试揭示了显著性能差距，尤其在抽象和规划任务上。我们开源数据集、生成脚本及评估工具，以促进透明、可复现的前沿研究。"}, "documents": [{"document_type": "registry_page", "id": "opencompass_hub:https://hub.opencompass.org.cn/dataset-detail/MORSE-500", "source": "opencompass_hub", "source_url": "https://hub.opencompass.org.cn/dataset-detail/MORSE-500", "title": "MORSE-500"}], "evidence_summary": {"document_count": 1, "model_count": null, "model_count_basis": null}, "key": "opencompass:1999", "languages": [], "modality": "multimodal", "name": "MORSE-500", "openness": {"access_gate": "none", "basis": "Row 6: linked target returned 404/410/timeout and no concrete data artifact was found", "code_license": "CC-BY-SA-4.0", "code_license_note": null, "data_license": null, "data_license_note": null, "data_located": "not_found_at_this_location", "evidence": [], "link_status": "timeout", "status": "unknown"}, "possible_variant": true, "provenance": {"crawl_bundle": "OpenCompassHub_Round2_Public_Evidence_2026-08-18", "crawled_at": "2026-08-18T00:00:00+00:00", "inputs": {"catalog_snapshot": {"crawled_at": "2026-08-17T18:57:37.200294+00:00", "file": "data/leaderboard_snapshots/opencompass_hub_catalog_2026-08-17.csv", "id": "opencompass_hub_2026-08-17", "source_url": "https://hub.opencompass.org.cn/home"}, "round2_evidence": {"crawled_at": "2026-08-18T00:00:00+00:00", "file": "data\\leaderboard_snapshots\\opencompass_round2\\opencompass_round2.jsonl", "id": "OpenCompassHub_Round2_Public_Evidence_2026-08-18"}}, "source_url": "https://hub.opencompass.org.cn/dataset-detail/MORSE-500"}, "publisher": {"locator": "detail.basicInfo.publishOrg", "name": "University of Maryland", "role": "hub_publisher"}, "released": "2025-06-05", "schema_version": 1, "sizes": [{"evidence_quote": "`test.zip`: Contains all MP4 video files", "evidence_url": "https://hub.opencompass.org.cn/dataset-detail/MORSE-500", "measures": "eval_set", "origin": "readme", "split": null, "unit": "videos", "value": 4}, {"evidence_quote": "`test_sz512.zip`: Contains MP4 video files resized to 512px for longside while keeping the original aspect ratio", "evidence_url": "https://hub.opencompass.org.cn/dataset-detail/MORSE-500", "measures": "unclear", "origin": "readme", "split": null, "unit": "videos", "value": 4}], "slug": "opencompass-1999-morse-500", "source": "opencompass_hub", "source_benchmark_id": "1999", "version_reported": null}, "schema_version": 1, "scores_by_source": {}, "siblings": []}
