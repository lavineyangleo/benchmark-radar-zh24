{"record": {"artifacts": [{"id": "arxiv:2505.12135", "kind": "paper", "locator": "linked URL", "url": "https://arxiv.org/pdf/2505.12135"}, {"id": "gh:choukrani/llm-babybench", "kind": "repo", "locator": "GitHub repository URL", "url": "https://github.com/choukrani/llm-babybench"}, {"id": "hf:salem-mbzuai/LLM-BabyBench", "kind": "dataset", "locator": "Hugging Face dataset URL", "url": "https://huggingface.co/datasets/salem-mbzuai/LLM-BabyBench"}], "categories": ["强推理", "Strong Reasoning", "智能体", "Agent", "任务执行", "Task Execution", "逻辑推理", "Reasoning", "不支持", "Unsupported"], "description": {"en": "LLM-BabyBench is a benchmark suite designed to evaluate Large Language Models (LLMs) on grounded planning and reasoning tasks.", "zh": "LLM-BabyBench是一个专门评估大语言模型在交互环境中规划和推理能力的新基准测试套件。基于BabyAI网格世界的文本适配版本，该基准评估LLMs在三个核心方面的表现：预测动作对环境状态的影响（Predict任务）、生成低级动作序列以实现指定目标（Plan任务）、以及将高级指令分解为连贯的子目标序列（Decompose任务）。\n基准包含16个难度级别，提供三种文本格式（Narrative、Structured、JSON），并配备OmniBot专家代理用于生成基准数据。"}, "documents": [{"document_type": "registry_page", "id": "opencompass_hub:https://hub.opencompass.org.cn/dataset-detail/LLM-BabyBench", "source": "opencompass_hub", "source_url": "https://hub.opencompass.org.cn/dataset-detail/LLM-BabyBench", "title": "LLM-BabyBench"}], "evidence_summary": {"document_count": 1, "model_count": null, "model_count_basis": null}, "key": "opencompass:1838", "languages": [], "modality": null, "name": "LLM-BabyBench", "openness": {"access_gate": "none", "basis": "Row 6: linked target returned 404/410/timeout and no concrete data artifact was found", "code_license": null, "code_license_note": null, "data_license": null, "data_license_note": null, "data_located": "not_found_at_this_location", "evidence": [], "link_status": "timeout", "status": "unknown"}, "possible_variant": false, "provenance": {"crawl_bundle": "OpenCompassHub_Round2_Public_Evidence_2026-08-18", "crawled_at": "2026-08-18T00:00:00+00:00", "inputs": {"catalog_snapshot": {"crawled_at": "2026-08-17T18:57:37.200294+00: