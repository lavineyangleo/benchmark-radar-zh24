{"record": {"artifacts": [], "categories": ["知识", "Knowledge", "NAACL 2025", "金融", "大语言模型", "LLM", "知识储备", "不支持", "Unsupported"], "description": {"en": "We present CFinBench: a meticulously crafted, the most comprehensive evaluation benchmark to date, for assessing the financial knowledge of LLMs under Chinese context.", "zh": "为了更加全面地探究大语言模型在中文财经领域的能力，本工作提出了目前为止量级最大的中文财经评测基准（CFinBench）。该数据集共包含99,100个评测样本，并包含单选题、多选题和判断题在内的三种题型。该工作对当前主流的大模型从四个维度进行了详细评测：财经学科基础、财经资格认证、财经从业实践、财经法律法规。数据集和测评代码均已开源。"}, "documents": [{"document_type": "registry_page", "id": "opencompass_hub:https://hub.opencompass.org.cn/dataset-detail/CFinBench", "source": "opencompass_hub", "source_url": "https://hub.opencompass.org.cn/dataset-detail/CFinBench", "title": "CFinBench"}], "evidence_summary": {"document_count": 1, "model_count": null, "model_count_basis": null}, "key": "opencompass:1907", "languages": ["Chinese"], "modality": null, "name": "CFinBench", "openness": {"access_gate": "none", "basis": "Row 5: data_located=not_found_at_this_location", "code_license": null, "code_license_note": null, "data_license": null, "data_license_note": null, "data_located": "not_found_at_this_location", "evidence": [], "link_status": "ok", "status": "unknown"}, "possible_variant": false, "provenance": {"crawl_bundle": "OpenCompassHub_Round2_Public_Evidence_2026-08-18", "crawled_at": "2026-08-18T00:00:00+00:00", "inputs": {"catalog_snapshot": {"crawled_at": "2026-08-17T18:57:37.200294+00:00", "file": "data/leaderboard_snapshots/opencompass_hub_catalog_2026-08-17.csv", "id": "opencompass_hub_2026-08-17", "source_url": "https://hub.opencompass.org.cn/home"}, "round2_evidence": {"crawled_at": "2026-08-18T00:00:00+00:00", "file": "data\\leaderboard_snapshots\\opencompass_round2\\opencompass_round2.jsonl", "id": "OpenCompassHub_Round2_Public_Evidence_2026-08-18"}}, "source_url": "https://hub.opencompass.org.cn/dataset-detail/CFinBench"}, "publisher": {"locator": "detail.basicInfo.publishOrg", "name": "华为, 新加坡南洋理工",