{"record": {"artifacts": [{"id": "arxiv:2507.04952", "kind": "paper", "locator": "linked URL", "url": "https://arxiv.org/abs/2507.04952"}, {"id": "gh:Tencent-Hunyuan/ArtifactsBenchmark", "kind": "repo", "locator": "GitHub repository URL", "url": "https://github.com/Tencent-Hunyuan/ArtifactsBenchmark"}], "categories": ["多模态", "Multimodal", "推理", "Reasoning", "代码", "Code", "ArtifactsBench", "代码可视化", "代码生成", "多模态模型", "VLM", "逻辑推理", "代码工程", "不支持", "Unsupported"], "description": {"en": "ArtifactsBench is a benchmark with 1,825 tasks for evaluating LLM-generated visual and interactive code. It addresses the gap of traditional benchmarks that focus only on algorithmic correctness by assessing visual fidelity and user interaction.", "zh": "rtifactsBench 是一个专注于弥合传统代码评测中“视觉-交互”鸿沟的新型基准。它旨在全面评估大语言模型（LLM）生成动态可视化与交互式代码的能力，而非仅仅考核算法正确性。\n该基准包含1825个真实世界的任务，并开创了一套自动化多模态评估流程：系统会自动渲染代码、捕捉其视觉与交互行为，再由一个多模态大模型（MLLM）依据详细清单进行评分。该流程与人类专家判断的一致性高达94.4%，证明了其高度可靠性。\nArtifactsBench 已将数据集、评估框架及工具链完全开源，为社区提供了一个可扩展且精准的工具，以推动能创造丰富用户体验的新一代生成模型的发展。"}, "documents": [{"document_type": "registry_page", "id": "opencompass_hub:https://hub.opencompass.org.cn/dataset-detail/ArtifactsBench", "source": "opencompass_hub", "source_url": "https://hub.opencompass.org.cn/dataset-detail/ArtifactsBench", "title": "ArtifactsBench"}], "evidence_summary": {"document_count": 1, "model_count": null, "model_count_basis": null}, "key": "opencompass:2052", "languages": [], "modality": "multimodal", "name": "ArtifactsBench", "openness": {"access_gate": "none", "basis": "Row 5: data_located=not_found_at_this_location", "code_license": null, "code_license_note": "file_present_unparsed", "data_license": null, "data_license_note": null, "data_located": "not_found_at_this_location", "evidence": [], "link_status": "ok", "status": "unknown"}, "possible_variant": false, "provenance": {"crawl_bundle": "OpenCompassHub_Round2_Public_Evidence_2026-08-18", "crawled_at": "2026-08-18T00:00:00+00:00", "inputs": {"catalog_snapshot": {"crawled_