{"record": {"artifacts": [{"id": "arxiv:2410.01495", "kind": "paper", "locator": "linked URL", "url": "https://arxiv.org/abs/2410.01495"}, {"id": "gh:zeroQiaoba/AffectGPT", "kind": "repo", "locator": "GitHub repository URL", "url": "https://github.com/zeroQiaoba/AffectGPT"}, {"id": "hf:MERChallenge/MER2025", "kind": "dataset", "locator": "Hugging Face dataset URL", "url": "https://huggingface.co/datasets/MERChallenge/MER2025"}], "categories": ["多模态", "Multimodal", "MER", "多模态模型", "VLM", "跨模态推理", "Cross-modal Reasoning", "音频理解", "Audio Understanding", "不支持", "Unsupported"], "description": {"en": "MER-UniBench is a benchmark designed to evaluate multimodal large language models (MLLMs) for their emotion understanding capabilities across typical multimodal emotion recognition (MER) tasks.", "zh": "MER-UniBench 是一个旨在评估多模态大语言模型（MLLM）在典型多模态情感识别（MER）任务中情感理解能力的评测基准。它涵盖了细粒度情感识别、基本情感识别和情感分析三个主要维度。该基准利用了包括 MER-Caption 在内的多个数据集，其中 MER-Caption 拥有超过 2000 种细粒度情感类别和 11.5 万个样本。"}, "documents": [{"document_type": "registry_page", "id": "opencompass_hub:https://hub.opencompass.org.cn/dataset-detail/MER-UniBench", "source": "opencompass_hub", "source_url": "https://hub.opencompass.org.cn/dataset-detail/MER-UniBench", "title": "MER-UniBench"}], "evidence_summary": {"document_count": 1, "model_count": null, "model_count_basis": null}, "key": "opencompass:2079", "languages": [], "modality": "multimodal", "name": "MER-UniBench", "openness": {"access_gate": "hf_gated", "basis": "Row 4: data_located=gated", "code_license": null, "code_license_note": null, "data_license": "CC-BY-NC-4.0", "data_license_note": null, "data_located": "gated", "evidence": [{"evidence_url": "https://huggingface.co/api/datasets/MERChallenge/MER2025", "locator": "gated"}, {"evidence_url": "https://huggingface.co/api/datasets/MERChallenge/MER2025", "locator": "cardData.license", "value": "cc-by-nc-4.0"}], "link_status": "ok", "status": "restricted"}, "possible_variant": false, "provenance": {"crawl_bundle": "OpenCompa