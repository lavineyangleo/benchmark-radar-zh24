{"record": {"artifacts": [{"id": "arxiv:2106.03193", "kind": "paper", "locator": "linked URL", "url": "https://arxiv.org/abs/2106.03193"}, {"id": "gh:facebookresearch/flores", "kind": "repo", "locator": "GitHub repository URL", "url": "https://github.com/facebookresearch/flores"}], "categories": ["语言", "Language", "大语言模型", "LLM", "语言理解", "Comprehension", "开源收录", "Open-Source", "不支持", "Unsupported"], "description": {"en": "Flores is a benchmark dataset for machine translation between English and low-resource languages, which consists of sentences translated from Wikipedia, involving English and four low-resource languages, namely Nepali, Sinhala, Khmer and Pashto. Flores has two versions, we use the Flores-101 version here, which is the second version including 101 languages besides english.", "zh": "Flores是一个用于评估低资源语言机器翻译的基准数据集，它包含了从维基百科翻译的句子，涉及英语和四种低资源语言，分别是尼泊尔语、僧伽罗语、高棉语和普什图语。Flores有两个版本，我们这里使用的是第一个版本Flores-101，它包含有除英语外的101种语言。"}, "documents": [{"document_type": "registry_page", "id": "opencompass_hub:https://hub.opencompass.org.cn/dataset-detail/Flores", "source": "opencompass_hub", "source_url": "https://hub.opencompass.org.cn/dataset-detail/Flores", "title": "Flores"}], "evidence_summary": {"document_count": 1, "model_count": null, "model_count_basis": null}, "key": "opencompass:509", "languages": ["English"], "modality": null, "name": "Flores", "openness": {"access_gate": "none", "basis": "Row 5: data_located=not_found_at_this_location", "code_license": null, "code_license_note": "file_present_unparsed", "data_license": null, "data_license_note": null, "data_located": "not_found_at_this_location", "evidence": [], "link_status": "ok", "status": "unknown"}, "possible_variant": false, "provenance": {"crawl_bundle": "OpenCompassHub_Round2_Public_Evidence_2026-08-18", "crawled_at": "2026-08-18T00:00:00+00:00", "inputs": {"catalog_snapshot": {"crawled_at": "2026-08-17T18:57:37.200294+00:00", "file": "data/leaderboard_snapshots/opencompass_hub_catalog_2026-08-17.csv",