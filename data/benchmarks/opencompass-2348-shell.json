{"record": {"artifacts": [{"id": "arxiv:2511.07107", "kind": "paper", "locator": "linked URL", "url": "https://arxiv.org/abs/2511.07107"}, {"id": "gh:KCshen1125/Shell", "kind": "repo", "locator": "GitHub repository URL", "url": "https://github.com/KCshen1125/Shell"}], "categories": ["安全", "Safety", "Implicit Risk", "大语言模型", "LLM", "安全对齐", "Safety Alignment", "合作共建", "Co-Built", "不支持", "Unsupported"], "description": {"en": "Targeting overlooked implicit risks in vertical domains (Education, Finance, Management), we introduce an implicit risk benchmark and the MENTOR framework. By leveraging Rule Evolution and Activation Steering, MENTOR effectively detects and mitigates these subtle hazards.", "zh": "Shell由华东师范大学Shell@Educhat团队和上海人工智能实验室联合推出。当下，确保垂直领域任务中大模型的安全性至关重要。虽然目前的对齐工作主要针对偏见和暴力等显性风险，但往往忽略了更深层次的特定领域隐性风险。研发团队推出了一个包含大量隐式风险查询的基准测试集，将风险分为引导、反思、禁止三类，以及 MENTOR 框架。该框架利用规则演化循环（REC）和激活引导（RV）技术，能够有效发现并缓解这些不易察觉的潜在风险。"}, "documents": [{"document_type": "registry_page", "id": "opencompass_hub:https://hub.opencompass.org.cn/dataset-detail/Shell", "source": "opencompass_hub", "source_url": "https://hub.opencompass.org.cn/dataset-detail/Shell", "title": "Shell"}], "evidence_summary": {"document_count": 1, "model_count": null, "model_count_basis": null}, "key": "opencompass:2348", "languages": [], "modality": null, "name": "Shell", "openness": {"access_gate": "none", "basis": "Row 5: data_located=not_found_at_this_location", "code_license": "Apache-2.0", "code_license_note": null, "data_license": null, "data_license_note": null, "data_located": "not_found_at_this_location", "evidence": [], "link_status": "ok", "status": "unknown"}, "possible_variant": false, "provenance": {"crawl_bundle": "OpenCompassHub_Round2_Public_Evidence_2026-08-18", "crawled_at": "2026-08-18T00:00:00+00:00", "inputs": {"catalog_snapshot": {"crawled_at": "2026-08-17T18:57:37.200294+00:00", "file": "data/leaderboard_snapshots/opencompass_hub_catalog_2026-08-17.csv", "id": "opencompass_hub_2026-08-17", "sour