{"record": {"artifacts": [{"id": "arxiv:2506.03828", "kind": "paper", "locator": "linked URL", "url": "https://arxiv.org/pdf/2506.03828"}, {"id": "gh:IBM/AssetOpsBench", "kind": "repo", "locator": "GitHub repository URL", "url": "https://github.com/IBM/AssetOpsBench"}], "categories": ["智能体", "Agent", "任务执行", "Task Execution", "不支持", "Unsupported"], "description": {"en": "AssetOpsBench is a comprehensive benchmark designed to evaluate the performance of large language models (LLMs) and AI agents in complex asset operation and maintenance tasks.", "zh": "AssetOpsBench 是一个专注于评估大语言模型（LLM）和智能体在资产运维领域复杂任务中实际表现的多维度评测基准。该基准旨在检验模型在工业场景下的任务规划、多步推理、工具调用、安全合规性以及领域知识理解等核心能力，覆盖设备维护、异常诊断、风险评估等典型运维场景。测试集包含 1,000 个高质量样本，涉及 5 大类任务和 20 余种细分领域，数据来源于真实运维手册、工单记录及专家验证案例。"}, "documents": [{"document_type": "registry_page", "id": "opencompass_hub:https://hub.opencompass.org.cn/dataset-detail/AssetOpsBench", "source": "opencompass_hub", "source_url": "https://hub.opencompass.org.cn/dataset-detail/AssetOpsBench", "title": "AssetOpsBench"}], "evidence_summary": {"document_count": 1, "model_count": null, "model_count_basis": null}, "key": "opencompass:1991", "languages": [], "modality": null, "name": "AssetOpsBench", "openness": {"access_gate": "none", "basis": "Row 5: data_located=not_found_at_this_location", "code_license": "Apache-2.0", "code_license_note": null, "data_license": null, "data_license_note": null, "data_located": "not_found_at_this_location", "evidence": [], "link_status": "ok", "status": "unknown"}, "possible_variant": false, "provenance": {"crawl_bundle": "OpenCompassHub_Round2_Public_Evidence_2026-08-18", "crawled_at": "2026-08-18T00:00:00+00:00", "inputs": {"catalog_snapshot": {"crawled_at": "2026-08-17T18:57:37.200294+00:00", "file": "data/leaderboard_snapshots/opencompass_hub_catalog_2026-08-17.csv", "id": "opencompass_hub_2026-08-17", "source_url": "https://hub.opencompass.org.cn/home"}, "round2_evidence": {"crawled_at": "2026-08-18T00:00:00+00:00", "file": "data\\leader