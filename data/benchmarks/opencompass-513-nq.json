{"record": {"artifacts": [{"id": "gh:google-research-datasets/natural-questions", "kind": "repo", "locator": "GitHub repository URL", "url": "https://github.com/google-research-datasets/natural-questions"}], "categories": ["知识", "knowledge", "大语言模型", "LLM", "知识储备", "开源收录", "Open-Source", "支持", "Supported"], "description": {"en": "NQ (NaturalQuestion) corpus contains questions from real users, and it requires QA systems to read and comprehend an entire Wikipedia article that may or may not contain the answer to the question. The inclusion of real user questions, and the requirement that solutions should read an entire page to find the answer, cause NQ to be a more realistic and challenging task than prior QA datasets.", "zh": "NQ 数据集来自于真实用户的问题，它要求 QA 系统阅读和理解整个维基百科文章，这些文章可能包含也可能不包含问题的答案。由真实用户问题构成，以及需要阅读整个页面才能找到答案的要求，比以往的 QA 数据集更现实和更具挑战性的任务。"}, "documents": [{"document_type": "registry_page", "id": "opencompass_hub:https://hub.opencompass.org.cn/dataset-detail/NQ", "source": "opencompass_hub", "source_url": "https://hub.opencompass.org.cn/dataset-detail/NQ", "title": "NQ"}], "evidence_summary": {"document_count": 1, "model_count": null, "model_count_basis": null}, "key": "opencompass:513", "languages": [], "modality": null, "name": "NQ", "openness": {"access_gate": "none", "basis": "Row 5: data_located=not_found_at_this_location", "code_license": "Apache-2.0", "code_license_note": null, "data_license": null, "data_license_note": null, "data_located": "not_found_at_this_location", "evidence": [], "link_status": "ok", "status": "unknown"}, "possible_variant": false, "provenance": {"crawl_bundle": "OpenCompassHub_Round2_Public_Evidence_2026-08-18", "crawled_at": "2026-08-18T00:00:00+00:00", "inputs": {"catalog_snapshot": {"crawled_at": "2026-08-17T18:57:37.200294+00:00", "file": "data/leaderboard_snapshots/opencompass_hub_catalog_2026-08-17.csv", "id": "opencompass_hub_2026-08-17", "source_url": "https://hub.opencompass.org.cn/home"}, "round2_evidence": {"crawled_at": "20