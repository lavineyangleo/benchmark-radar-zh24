{"record": {"artifacts": [{"id": "arxiv:2505.11109", "kind": "paper", "locator": "linked URL", "url": "https://arxiv.org/pdf/2505.11109"}, {"id": "hf:unibuc-cs/MAVOS-DD", "kind": "dataset", "locator": "Hugging Face dataset URL", "url": "https://huggingface.co/datasets/unibuc-cs/MAVOS-DD"}], "categories": ["多模态", "Multimodal", "安全", "Safety", "VQA", "AVQA", "多模态模型", "VLM", "安全对齐", "Safety Alignment", "音频理解", "Audio Understanding", "不支持", "Unsupported"], "description": {"en": "MAVOS-DD is the first large-scale open-set benchmark for multilingual audio-video deepfake detection.", "zh": "MAVOS-DD是一个大规模的多语言音视频深度伪造检测基准数据集，包含超过250小时的真实和伪造视频，涵盖八种语言。该数据集通过七种不同的深度伪造生成模型生成伪造视频，这些模型基于不同的生成方法，包括说话头像生成、表情转移和换脸。MAVOS-DD设计了多种开放集测试场景，包括开放集模型、开放集语言和全开放集，以评估深度伪造检测模型在未知模型和语言下的泛化能力。实验结果表明，现有的深度伪造检测模型在开放集场景下的性能显著下降，凸显了开发更鲁棒检测技术的必要性。"}, "documents": [{"document_type": "registry_page", "id": "opencompass_hub:https://hub.opencompass.org.cn/dataset-detail/MAVOS-DD", "source": "opencompass_hub", "source_url": "https://hub.opencompass.org.cn/dataset-detail/MAVOS-DD", "title": "MAVOS-DD"}], "evidence_summary": {"document_count": 1, "model_count": null, "model_count_basis": null}, "key": "opencompass:1848", "languages": ["Multilingual"], "modality": "multimodal", "name": "MAVOS-DD", "openness": {"access_gate": "none", "basis": "Row 6: linked target returned 404/410/timeout and no concrete data artifact was found", "code_license": null, "code_license_note": null, "data_license": null, "data_license_note": null, "data_located": "not_found_at_this_location", "evidence": [], "link_status": "timeout", "status": "unknown"}, "possible_variant": false, "provenance": {"crawl_bundle": "OpenCompassHub_Round2_Public_Evidence_2026-08-18", "crawled_at": "2026-08-18T00:00:00+00:00", "inputs": {"catalog_snapshot": {"crawled_at": "2026-08-17T18:57:37.200294+00:00", "file": "data/leaderboard_snapshots/opencompass_hub_catalog_2026-08-17.csv", "id": "opencompass_hub_2026-08-17", "source_url": "https://hub.opencompa